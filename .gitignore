__pycache__/
*.py[cod]
.venv/

# Agent workspaces and scratch. Agent plans, specs, task reports and SDD logs are
# not tracked; archive them under .superpowers/archive/.
.superpowers/
.worktrees/
.claude/
.codex/
.cursor/
.gemini/
.opencode/
.aider*
.agents/
.omx/
.serena/
docs/superpowers/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.DS_Store

# Licensed TTC measurements and local correlation artifacts; never commit.
/private/
/tire_fits_out/

# Private real-car source files; never commit this directory.
/IEM24 Files/
*.xlsx
*.xls

# Heavy per-attempt run artifacts. Ignoring only affects untracked files: already
# tracked attempt files stay tracked, and summary.json, parent.json, *certificate*.json
# and *_summary.json are deliberately not matched.
docs/validation/**/attempt_*/source_snapshot/
docs/validation/**/attempt_*/*.npz
docs/validation/**/attempt_*/trace.csv
docs/validation/**/attempt_*/pedal.csv
docs/validation/**/attempt_*/run.log
docs/validation/**/attempt_*/simulated_lap_7dof.csv
# Per-accepted-state channel exports from tools/reports/export_forward_attempt_channels.py
# (the six comparison channels plus bus quantities; ~3-6 MB each). Their
# *_summary.json sits beside them and stays tracked.
docs/validation/**/attempt_*/*_channels.csv

# Exported animations are large and regenerate from a run record with
# tools/anim/export_animation.py (see docs/dev/animation-export.md). Keep them in videos/.
/videos/
/runs/
# Default output folder of tools/track_gui.
/tracks_out/
# Default output folder of tools/vehicle_gui.
/vehicles_out/
/models/sweeps/
*.mp4
*.mov
*.mkv
*.webm
*.partial.*
