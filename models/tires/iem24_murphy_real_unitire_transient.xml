<model schema-version="1.0" id="iem24-murphy-real-unitire-transient" type="tire-model" subtype="unitire-transient-simple">
    <!-- PROPOSED provisional transient coefficients, not fitted to this Hoosier and not validated. This file holds only scalars; the steady force law stays in iem24_murphy_real_unitire.xml (shared assembly role "tire"; this file is role "tire-transient"). Reduced specialization of Ma et al., Machines 2022, 10(7), 527, DOI 10.3390/machines10070527, equations 61 and 64 (equation numbers from the project plan, paper text not re-verified). A transient tire fitting tool is required before any measured-vehicle accuracy claim. -->
    <!-- PROPOSED: longitudinal relaxation length = scale * k_x(Fz)/k_cx (extension, not from the paper). About 0.1195 m at rated load 660 N. -->
    <!-- PROPOSED: lateral relaxation length = scale * k_y(Fz)/k_cy. About 0.1533 m at rated load. -->
    <!-- PROPOSED: trail pole ratio m (dimensionless); trail time constant length = sigma_y/m. The published m is tire-specific. -->
    <!-- PROPOSED: trail lead ratio n (dimensionless, 0 to 1); the published n is tire-specific. -->
    <parameters>
        <parameter name="longitudinal_length_scale" value="1.0" unit="1" />
        <parameter name="lateral_length_scale" value="1.0" unit="1" />
        <parameter name="trail_pole_ratio" value="1.0" unit="1" />
        <parameter name="trail_lead_ratio" value="0.25" unit="1" />
    </parameters>
</model>
