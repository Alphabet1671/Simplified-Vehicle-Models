        <component role="drivetrain" ref="../drivetrains/iem24_murphy_real.xml" />
        <component role="suspension" ref="../suspensions/iem24_murphy_real_suspension.xml" />
        <component role="tire-transient" ref="../tires/iem24_murphy_real_unitire_transient.xml" />
    </components>
</model>
